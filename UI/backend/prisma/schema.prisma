generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRADER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum BrokerPlatform {
  MT4
  MT5
  CTRADER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TraderApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           Role            @default(TRADER)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile              Profile?
  brokerAccounts       BrokerAccount[]
  apiKeys              ApiKey[]
  churnFeedbacks       ChurnFeedback[]
  analysisSnapshots    AnalysisSnapshot[]
  storedTrades         StoredTrade[]
  stripeCustomerId     String?
  stripeSubscriptionId String?
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrokerAccount {
  id            String         @id @default(cuid())
  userId        String
  platform      BrokerPlatform
  brokerName    String?
  accountNumber String
  label         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eaEvents      EaEvent[]
  storedTrades  StoredTrade[]

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  keyHash   String
  last4     String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EaEvent {
  id              String        @id @default(cuid())
  brokerAccountId String
  type            String
  payload         Json
  receivedAt      DateTime      @default(now())
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // e.g. "landing"
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String
  message   String
  createdAt DateTime @default(now())
}

model TraderApplication {
  id              String                 @id @default(cuid())
  fullName        String
  email           String                 @unique
  country         String
  brokerName      String?
  platform        BrokerPlatform
  accountNumber   String
  experienceLevel ExperienceLevel
  status          TraderApplicationStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime               @default(now())
  reviewedAt      DateTime?

  @@index([status])
}

model ChurnFeedback {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  feedback  String?
  plan      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model AnalysisSnapshot {
  id             String   @id @default(cuid())
  userId         String
  report         Json
  tradesAnalysed Int?
  avgRMultiple   Float?
  winRate        Float?
  sharpeRatio    Float?
  maxDrawdownR   Float?
  totalR         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model StoredTrade {
  id              String        @id @default(cuid())
  userId          String
  brokerAccountId String?
  source          String
  tradeIdentity   String
  externalTradeId String?
  symbol          String?
  side            String
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  exitPrice       Float
  stopLoss        Float
  takeProfit      Float
  mfe             Float?
  mae             Float?
  session         String?
  spread          Float?
  volatility      Float?
  volume          Float?
  profit          Float?
  commission      Float?
  swap            Float?
  rawTrade        Json
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount   BrokerAccount? @relation(fields: [brokerAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, tradeIdentity])
  @@index([userId, exitTime])
  @@index([brokerAccountId, exitTime])
}
