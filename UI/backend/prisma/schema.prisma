generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRADER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum BrokerPlatform {
  MT4
  MT5
  CTRADER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TraderApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnalysisRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BillingEventStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  ACTIVE
  INACTIVE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           Role            @default(TRADER)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile              Profile?
  brokerAccounts       BrokerAccount[]
  apiKeys              ApiKey[]
  churnFeedbacks       ChurnFeedback[]
  analysisSnapshots    AnalysisSnapshot[]
  analysisRuns         AnalysisRun[]
  storedTrades         StoredTrade[]
  billingEvents        BillingEvent[]
  deletionAudits       AccountDeletionAudit[]
  referralCodesCreated ReferralCode[]    @relation("ReferralCodeCreatedBy")
  appliedReferralCode  ReferralCode?     @relation("ReferralCodeAppliedToUsers", fields: [appliedReferralCodeId], references: [id], onDelete: SetNull)
  appliedReferralCodeId String?
  accountDiscountPercent Float?
  mlRunDiscountPercent   Float?
  referralDiscountExpiresAt DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
}

model AccountDeletionAudit {
  id                 String   @id @default(cuid())
  userId             String
  previousEmail      String
  deletedEmail       String
  deletedAt          DateTime @default(now())
  stripeCustomerId   String?
  stripeSubscriptionId String?
  hadBillingHistory  Boolean  @default(false)
  hadBrokerAccounts  Boolean  @default(false)
  hadApiKeys         Boolean  @default(false)
  metadata           Json?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrokerAccount {
  id            String         @id @default(cuid())
  userId        String
  platform      BrokerPlatform
  brokerName    String?
  accountNumber String
  label         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eaEvents      EaEvent[]
  storedTrades  StoredTrade[]

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  keyHash   String
  last4     String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EaEvent {
  id              String        @id @default(cuid())
  brokerAccountId String
  type            String
  payload         Json
  receivedAt      DateTime      @default(now())
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // e.g. "landing"
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String
  message   String
  createdAt DateTime @default(now())
}

model TraderApplication {
  id              String                 @id @default(cuid())
  fullName        String
  email           String                 @unique
  country         String
  brokerName      String?
  platform        BrokerPlatform
  accountNumber   String
  experienceLevel ExperienceLevel
  status          TraderApplicationStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime               @default(now())
  reviewedAt      DateTime?

  @@index([status])
}

model ChurnFeedback {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  feedback  String?
  plan      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model AnalysisSnapshot {
  id             String   @id @default(cuid())
  userId         String
  report         Json
  tradesAnalysed Int?
  avgRMultiple   Float?
  winRate        Float?
  sharpeRatio    Float?
  maxDrawdownR   Float?
  totalR         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisRuns   AnalysisRun[]

  @@index([userId, updatedAt])
}

model AnalysisRun {
  id                String            @id @default(cuid())
  userId            String
  analysisSnapshotId String?
  status            AnalysisRunStatus @default(RUNNING)
  mode              String
  requestedTrades   Int?
  tradesAnalysed    Int?
  cost              Float?
  periodDescription String?
  dateRangeStart    DateTime?
  dateRangeEnd      DateTime?
  error             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completedAt       DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisSnapshot  AnalysisSnapshot? @relation(fields: [analysisSnapshotId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StoredTrade {
  id              String        @id @default(cuid())
  userId          String
  brokerAccountId String?
  source          String
  tradeIdentity   String
  externalTradeId String?
  symbol          String?
  side            String
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  exitPrice       Float
  stopLoss        Float
  takeProfit      Float
  mfe             Float?
  mae             Float?
  session         String?
  spread          Float?
  volatility      Float?
  volume          Float?
  profit          Float?
  commission      Float?
  swap            Float?
  notes           String?
  emotions        String?
  lessonsLearned  String?
  rawTrade        Json
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  lastAnalysedAt  DateTime?
  analysisCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount   BrokerAccount? @relation(fields: [brokerAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, tradeIdentity])
  @@index([userId, exitTime])
  @@index([brokerAccountId, exitTime])
}

model BillingEvent {
  id                   String             @id @default(cuid())
  userId               String?
  stripeEventId        String?            @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeInvoiceId      String?
  eventType            String
  status               BillingEventStatus?
  currency             String?
  amount               Float?
  amountSubtotal       Float?
  amountTax            Float?
  amountPaid           Float?
  periodStart          DateTime?
  periodEnd            DateTime?
  occurredAt           DateTime
  payload              Json
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([stripeCustomerId, occurredAt])
  @@index([stripeSubscriptionId, occurredAt])
  @@index([stripeInvoiceId])
  @@index([eventType, occurredAt])
}

model ReferralCode {
  id                     String   @id @default(cuid())
  code                   String   @unique
  accountDiscountPercent Float
  mlRunDiscountPercent   Float
  durationDays           Int
  isActive               Boolean  @default(true)
  createdByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              User?    @relation("ReferralCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appliedToUsers         User[]   @relation("ReferralCodeAppliedToUsers")

  @@index([isActive, createdAt])
}
